BRIDGE_PUBLIC_ORIGIN=https://agents.example.internal
# Set only the exact reverse proxy IP/CIDR, as seen from the app container.
# BRIDGE_TRUST_PROXY=172.17.0.1
# SSO is opt-in; use compose.sso.yaml and docs/FASTKORE-SSO-PILOT.md.
# Fastkore CLI runner and SSO tickets are configured in docs/CODEX-WORKER.md.
# BRIDGE_FASTKORE_CLI_TICKETS=1
# BRIDGE_FASTKORE_CLI_SERVER=grpc://mcp.fastkore.ru:17050
# Optional Z.ai endpoint override for GLM accounts (default https://api.z.ai/api/v1).
# BRIDGE_GLM_BASE_URL=
# Optional external S3. Create the bucket first. For local MinIO use compose.minio.yaml.
# BRIDGE_S3_ENDPOINT=https://s3.example.internal
# BRIDGE_S3_BUCKET=agentic-platform-files
# BRIDGE_S3_REGION=us-east-1
# BRIDGE_S3_ACCESS_KEY=
# BRIDGE_S3_SECRET_KEY=
# BRIDGE_S3_FORCE_PATH_STYLE=1

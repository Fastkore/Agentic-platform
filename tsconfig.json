{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["client", "shared", "vite.config.ts"]
}

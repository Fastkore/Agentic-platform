FROM node:24.19.0-bookworm-slim AS antigravity
ADD https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.7-6190022064472064/linux-x64/cli_linux_x64.tar.gz /tmp/agy.tar.gz
RUN echo '60bca280414ed11723f58b3b671962ae394cc2d0c25e3f58e32e1c6847c978cbc77ec6f40e7f3992001c399d80aeb8b64c9ec892abddd591b12413c5ee6d9fce  /tmp/agy.tar.gz' | sha512sum -c - \
    && tar xzf /tmp/agy.tar.gz -C /usr/local/bin antigravity \
    && mv /usr/local/bin/antigravity /usr/local/bin/agy
COPY deploy/agy-region-patch.mjs /tmp/agy-region-patch.mjs
RUN node /tmp/agy-region-patch.mjs /usr/local/bin/agy && rm /tmp/agy-region-patch.mjs

FROM node:24.19.0-bookworm-slim AS cli
RUN npm install -g @openai/codex@0.167.1 --no-audit --no-fund \
    && mkdir -p /etc/codex /home/node/.codex /run/bridge-codex /runner \
    && chown node:node /home/node/.codex /run/bridge-codex
RUN npm install -g @google/gemini-cli@0.68.0 --omit=optional --no-audit --no-fund
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/codex-runner.toml /etc/codex/config.toml
COPY deploy/gemini-runner.json /etc/gemini-cli/settings.json
COPY --from=antigravity /usr/local/bin/agy /usr/local/bin/agy
ENV HOME=/home/node CODEX_HOME=/home/node/.codex

FROM cli AS office-python
COPY deploy/office-requirements.txt /tmp/office-requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv=3.11.2-1+b1 \
    && python3 -m venv /tmp/office-build \
    && python3 -m venv --without-pip /opt/bridge-office \
    && /tmp/office-build/bin/pip --python /opt/bridge-office install --no-cache-dir --only-binary=:all: \
        --require-hashes -r /tmp/office-requirements.txt

FROM node:24.19.0-bookworm-slim AS office-sandbox
WORKDIR /tmp
RUN apt-get update && apt-get download bubblewrap=0.8.0-2+deb12u1 \
    && dpkg-deb -x bubblewrap_*.deb /tmp/office-sandbox

FROM node:24.19.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY server ./server
COPY shared ./shared
RUN npx --no-install tsc -p server/tsconfig.json && npm prune --omit=dev --no-audit --no-fund

FROM cli
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3=3.11.2-1+b1 \
        libreoffice-writer-nogui=4:7.4.7-1+deb12u14 libreoffice-calc-nogui=4:7.4.7-1+deb12u14 \
        poppler-utils=22.12.0-2+deb12u3 \
        fonts-liberation2=2.1.5-1 fonts-crosextra-carlito=20220224-1 fonts-crosextra-caladea=20200211-1 \
        fonts-paratype=20181108-3 fonts-dejavu-core=2.37-6 fonts-open-sans=1.11-2 fonts-roboto-unhinted=2:0~20170802-3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=office-python /opt/bridge-office /opt/bridge-office
# Keep this binary off PATH so Codex continues to use its bundled sandbox.
COPY --from=office-sandbox /tmp/office-sandbox/usr/bin/bwrap /opt/bridge-office/bwrap
COPY --from=office-sandbox /tmp/office-sandbox/usr/share/doc/bubblewrap/copyright /usr/share/doc/bridge-office-bubblewrap/copyright
COPY --chmod=0755 deploy/fk-office.py /usr/local/bin/fk-office
COPY deploy/office-fonts.conf /etc/fonts/conf.d/30-bridge-office.conf
RUN install -d -m 0755 /opt/bridge-office/slots \
    && touch /opt/bridge-office/slots/1 /opt/bridge-office/slots/2 \
    && chmod 0444 /opt/bridge-office/slots/* \
    && fc-cache -f
ENV PATH=/opt/bridge-office/bin:$PATH
WORKDIR /app
COPY deploy/gigachat-ca.crt ./deploy/gigachat-ca.crt
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "dist/server/codex-worker.js"]

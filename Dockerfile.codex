FROM node:24.19.0-bookworm-slim AS antigravity
ADD https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.7-6190022064472064/linux-x64/cli_linux_x64.tar.gz /tmp/agy.tar.gz
RUN echo '60bca280414ed11723f58b3b671962ae394cc2d0c25e3f58e32e1c6847c978cbc77ec6f40e7f3992001c399d80aeb8b64c9ec892abddd591b12413c5ee6d9fce  /tmp/agy.tar.gz' | sha512sum -c - \
    && tar xzf /tmp/agy.tar.gz -C /usr/local/bin antigravity \
    && mv /usr/local/bin/antigravity /usr/local/bin/agy

FROM node:24.19.0-bookworm-slim AS cli
RUN npm install -g @openai/codex@0.167.1 --no-audit --no-fund \
    && mkdir -p /etc/codex /home/node/.codex /run/bridge-codex /runner \
    && chown node:node /home/node/.codex /run/bridge-codex
RUN npm install -g @google/gemini-cli@0.68.0 --omit=optional --no-audit --no-fund
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/codex-runner.toml /etc/codex/config.toml
COPY deploy/gemini-runner.json /etc/gemini-cli/settings.json
COPY --from=antigravity /usr/local/bin/agy /usr/local/bin/agy
ENV HOME=/home/node CODEX_HOME=/home/node/.codex

FROM node:24.19.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY server ./server
COPY shared ./shared
RUN npx --no-install tsc -p server/tsconfig.json && npm prune --omit=dev --no-audit --no-fund

FROM cli
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "dist/server/codex-worker.js"]
